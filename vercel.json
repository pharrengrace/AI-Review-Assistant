{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/review",
      "dest": "/public/review.html"
    },
    {
      "src": "/review.html",
      "dest": "/public/review.html"
    }
  ]
}